                  { "type": "A", "anchorType": "LINK", "start": 0, "end": 18, "href": "https://blog.example.co.uk" },
                  { "type": "STRONG", "start": 19, "end": 34 },
                  { "type": "EM", "start": 35, "end": 67 }
                ] },
              { "type": "MIXTURE_EMBED", "text": "blog.example.co.uk Example Article A deep dive into example things",
                "name": "e5", "layout": "",
                "mixtapeMetadata": { "href": "https://blog.example.co.uk/post", "thumbnailImageId": "thumb-d" },
