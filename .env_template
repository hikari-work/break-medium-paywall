# HOST_ADDRESS: Address of the current Freedium instance
HOST_ADDRESS = "http://localhost:6752"

# TIMEOUT: Timeout in seconds for the requests
TIMEOUT=15

# ADMIN_SECRET_KEY: Secret key that will be used to get access for some internal admin API endpoints
ADMIN_SECRET_KEY="test"

# MEDIUM_AUTH_COOKIES="Get your Medium subscription account coockies here ONLY IF YOU HAVE A PAID SUBSCRIPTION, uid and sid properties is required"

# PROXY_LIST: Comma-separated list of proxies to use for the requests. If not set, the requests will be sent without a proxy
# PROXY_LIST=socks5://wgcf1:1080

# SHADOW_MODE: Rust-only, not in config.py, and left off deliberately.
# Set it on an instance that is fed a *copy* of production's traffic and whose
# responses are compared against Python's (Fase 4). A shadow never fetches —
# on a durable-cache miss it answers 503 with an X-Freedium-Shadow header, so
# the comparison can skip it rather than mistake it for a difference — and it
# never sends a Telegram alert.
#
# Never set this on the instance that serves users: it would stop fetching.
# SHADOW_MODE=false

# --- Public API (/api/v1), Rust-only — Fase 6 ------------------------------
# The API is anonymous and always will be: these variables tune *cost*, not
# access. All of them are optional; the defaults below are what the binary uses
# when the variable is absent, and they are deliberately tight.
#
# API_TOKEN: turns on an optional "trusted client" rate-limit tier. Empty or
# unset (the default) disables the tier entirely and the X-API-TOKEN header is
# ignored. A non-matching token is a 401. It does NOT grant access to anything
# and NOT raise the global fetch budget.
# API_TOKEN=""
#
# API_TOKEN_LIMIT_PER_MINUTE=60
# API_TOKEN_LIMIT_BURST=20
#
# Per-IP buckets. The miss bucket is charged only when the durable cache does
# not have the post, which is the only case that spends a Medium request.
# API_RATE_LIMIT_PER_MINUTE=10
# API_RATE_LIMIT_BURST=5
# API_MISS_LIMIT_PER_MINUTE=3
# API_MISS_LIMIT_BURST=1
#
# Process-global budget for outbound fetches and link.medium.com resolves.
# Global on purpose: what it protects is the single WARP exit, and a token
# cannot raise it. Raise it only against a measurement of what one exit takes.
# API_FETCH_BUDGET_PER_MINUTE=30
# API_FETCH_BUDGET_BURST=5
#
# API_CACHE_SECONDS: the API's Cache-Control max-age. There is no purge path
# anywhere in this system, so a large value outlives deploys and parser fixes
# and cannot be flushed. Raise this only once there is a purge story.
# API_CACHE_SECONDS=300
#
# API_TRUST_PROXY: take the client IP from X-Real-IP/X-Forwarded-For. Leave it
# false unless something in front of this process *overwrites* those headers:
# anything that can set its own X-Real-IP can pick its own bucket. Note that
# production puts an external proxy in front of Caddy, so with this false every
# real client shares one bucket — see README.md / RUST_REWRITE_PLAN §2.7.
# API_TRUST_PROXY=false
#
# CORS_ALLOW_ORIGINS: comma-separated allowlist for /api/v1 only. Empty (the
# default) mirrors the request's Origin, as the page routes do.
# CORS_ALLOW_ORIGINS=""
#
# MEDIUM_GRAPHQL_ENDPOINT: NOT a production knob. It points the API's fetches at
# a different GraphQL endpoint and exists so the upstream failure paths can be
# proved locally against a fake server. Empty means the real endpoint.
# MEDIUM_GRAPHQL_ENDPOINT=""

# .... and more values to change you can find in ./legacy/web/server/config.py and docker-compose rules folder
